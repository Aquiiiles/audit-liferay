<?xml version="1.0"?>
<!DOCTYPE service-builder PUBLIC "-//Liferay//DTD Service Builder 7.4.0//EN"
		"http://www.liferay.com/dtd/liferay-service-builder_7_4_0.dtd">

<service-builder
		dependency-injector="ds"
		package-path="com.liferay.audit">

	<namespace>AUDIT</namespace>

	<entity
			name="AuditEntry"
			local-service="true"
			remote-service="false"
			uuid="true">

		<!-- PK -->
		<column name="auditEntryId" type="long" primary="true" />

		<!-- Scope -->
		<column name="groupId" type="long" />
		<column name="companyId" type="long" />

		<!-- Audit metadata -->
		<column name="userId" type="long" />
		<column name="userName" type="String" />
		<column name="createDate" type="Date" />
		<column name="modifiedDate" type="Date" />

		<!-- Audited target -->
		<column name="entityName" type="String" />
		<column name="entityId" type="long" />

		<!-- Change data -->
		<column name="action" type="String" />
		<column name="fieldName" type="String" />
		<column name="oldValue" type="String" />
		<column name="newValue" type="String" />

	</entity>

</service-builder>
